# ============================================================================
# License Plate Detection & OCR System — backend environment (app/backend)
# ============================================================================
# Copy this file to `.env` (or set the variables in your process manager /
# deployment dashboard). Every variable here is OPTIONAL: when unset, the
# application derives sensible defaults from the repository layout.
#
# Uncomment and set only what you actually need. NEVER commit a real `.env`.
# This file intentionally contains placeholders only — no keys, tokens or
# secrets of any kind.
#
# Variable names are the existing `LVA_*` names used by the current code; they
# are preserved for backward compatibility.
# ============================================================================

# --- Paths -------------------------------------------------------------------
# Project root. Defaults to the folder containing `app/backend` (auto-detected).
# LVA_PROJECT_ROOT=C:/path/to/License Plate Detection

# Trained YOLO weights.
# Default: <root>/runs/detect/models/license_plate_detector/weights/best.pt
# LVA_MODEL_PATH=C:/path/to/runs/detect/models/license_plate_detector/weights/best.pt

# Saved batch analytics (read-only, produced by the offline batch pipeline).
# LVA_BATCH_CSV=<root>/batch_results/batch_results.csv
# LVA_DASHBOARD_JSON=<root>/batch_results/analytics/dashboard_data.json

# Saved video analytics (read-only, produced by the offline video pipeline).
# LVA_VIDEO_DETECTIONS_CSV=<root>/video_results/detections.csv
# LVA_VIDEO_SUMMARY_JSON=<root>/video_results/video_summary.json
# LVA_ANNOTATED_VIDEO=<root>/video_results/annotated_video.mp4

# YOLO training metrics shown on the Model Performance page.
# LVA_TRAINING_RESULTS_CSV=<root>/runs/detect/models/license_plate_detector/results.csv

# --- Behaviour ---------------------------------------------------------------
# Comma-separated list of frontend origin(s) allowed by CORS.
# Defaults to the local dev origins (http://localhost:5173, http://127.0.0.1:5173).
# REQUIRED in production — without it the browser blocks every API call.
# A trailing slash is ignored. Example:
# LVA_FRONTEND_ORIGIN=https://your-frontend.example.com

# Per-request timing and OCR-candidate logging.
# Default: 1 (on). Set to 0 for quieter production logs.
# LVA_DEBUG_TIMING=0

# Enables the debug-only endpoint POST /api/debug/plate-crop and debug payloads
# (the caller must also opt in per request). Default: 0 (off).
# Never enable this in production — it returns diagnostic crops/candidates.
# LVA_DEBUG_MODE=0
