# Frontend environment configuration (app/frontend).
#
# Copy this file to .env.local for local development, or set the variables
# in the Render dashboard (Environment section) for production builds.
# NEVER commit a real .env file.
#
# Full origin of the FastAPI backend. Required in production builds:
#   - Vite inlines it at BUILD time — changing it requires a rebuild.
#   - If unset in a production build, every API call fails fast with an
#     explicit configuration error instead of silently calling
#     http://localhost:8000.
#   - Local development does NOT need this; the dev default is
#     http://localhost:8000.
#
# Example:
# VITE_API_BASE=https://license-plate-recognition-system-q6qx.onrender.com
VITE_API_BASE=http://localhost:8000
